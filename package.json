{
  "name": "stresssignal-nextjs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "predev": "pnpm assets:generate",
    "prebuild": "pnpm content:generate && pnpm assets:generate",
    "dev": "next dev",
    "build": "next build",
    "start": "opennextjs-cloudflare preview",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --config wrangler.typegen.jsonc --env-file .env.example --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:typecheck": "wrangler types --config wrangler.typegen.jsonc --env-file .env.example --env-interface CloudflareEnv cloudflare-env.d.ts --check",
    "assets:generate": "tsx scripts/generate-static-brand-assets.ts",
    "bundle:check": "tsx scripts/check-worker-bundle-size.ts",
    "content:generate": "tsx scripts/generate-article-sources.ts",
    "content:check": "tsx scripts/generate-article-sources.ts --check",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply stresssignal-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply stresssignal-db --local",
    "db:export-neon": "tsx scripts/export-neon-to-d1.ts",
    "seed:indicators": "tsx scripts/seed-indicators.ts",
    "seed:indicators:local": "tsx scripts/seed-indicators.ts --local",
    "sync:fred": "tsx scripts/sync-fred.ts",
    "sync:public-sources": "tsx scripts/sync-public-sources.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "pg": "^8.21.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7",
    "wrangler": "^4.118.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
