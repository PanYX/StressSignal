# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/tests/e2e/.artifacts/
/tests/e2e/.playwright-report/
/tests/e2e/.e2e-runtime.json
/tests/e2e/.wrangler-state/

# next.js
/.next/
/.open-next/
/out/

# generated static brand assets
/public/apple-icon.png
/public/icon.png
/public/social-card.png

# Cloudflare local state and one-off database exports
/.wrangler/
/.d1-import/

# production
/build

# local orchestration artifacts
/workflow/
/docs/workflow/

# local one-off scripts
/scripts/.tmp-*

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
